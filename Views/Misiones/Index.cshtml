@model List<Mision>
@{
    ViewData["Title"] = "Mis misiones";
}

<div class="titulo">
    <div>
        <h1>Mis misiones</h1>
        <span class="suave">@Model.Count registradas</span>
    </div>
    <a class="boton" asp-action="Create">Nueva misión</a>
</div>

@* Error de conexión o consulta enviado por el controlador *@
@if (ViewBag.Error != null)
{
    <p class="aviso error">@ViewBag.Error</p>
}

@if (Model.Count == 0)
{
    <p class="vacio suave">Aún no tienes misiones registradas.</p>
}
else
{
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Ubicación</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Mision mision in Model)
                {
                    <tr>
                        <td>@mision.Nombre</td>
                        <td class="suave">@mision.Descripcion</td>
                        <td>@mision.Ubicacion</td>
                        <td>@mision.FechaMision.ToString("dd/MM/yyyy")</td>
                        @* "En progreso" -> clase "estado-en-progreso" *@
                        <td><span class="estado estado-@(mision.Estado.ToLower().Replace(" ", "-"))">@mision.Estado</span></td>
                        <td class="acciones">
                            <a asp-action="Details" asp-route-id="@mision.Id">Ver</a>
                            <a asp-action="Edit" asp-route-id="@mision.Id">Editar</a>
                            <a asp-action="Delete" asp-route-id="@mision.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
